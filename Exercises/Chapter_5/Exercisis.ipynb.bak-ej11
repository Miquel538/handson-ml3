   "source": [
    "9.- Entrena un LinearSVC en un conjunto de datos separables linealmente. Después entrena un SVC y un SGDClassifier en el mismo conjunto de datos. Mira si puedes conseguir que produzcan aproximadamente el mismo modelo."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "89f52ee1",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-28T06:44:34.414084Z",
     "iopub.status.busy": "2026-07-28T06:44:34.413959Z",
     "iopub.status.idle": "2026-07-28T06:44:35.311781Z",
     "shell.execute_reply": "2026-07-28T06:44:35.310853Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "LinearSVC\n",
      "Exactitud: 1.0\n",
      "Coeficientes: [[1.00310431 1.12110753]]\n",
      "Intercepto: [0.02601735]\n",
      "\n",
      "SVC lineal\n",
      "Exactitud: 1.0\n",
      "Coeficientes: [[1.00486413 1.11868266]]\n",
      "Intercepto: [0.02636416]\n",
      "\n",
      "SGDClassifier\n",
      "Exactitud: 1.0\n",
      "Coeficientes: [[1.07075429 1.21162065]]\n",
      "Intercepto: [0.0424967]\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from sklearn.datasets import make_blobs\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.svm import LinearSVC, SVC\n",
    "from sklearn.linear_model import SGDClassifier\n",
    "from sklearn.metrics import accuracy_score\n",
    "\n",
    "# Conjunto de datos linealmente separable\n",
    "X, y = make_blobs(\n",
    "    n_samples=200,\n",
    "    centers=[(-2, -2), (2, 2)],\n",
    "    cluster_std=0.7,\n",
    "    random_state=42,\n",
    ")\n",
    "\n",
    "# El escalado favorece la convergencia de las SVM y SGD\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X)\n",
    "\n",
    "C = 1.0\n",
    "\n",
    "linear_svc = LinearSVC(\n",
    "    C=C,\n",
    "    loss=\"hinge\",\n",
    "    dual=True,\n",
    "    max_iter=100_000,\n",
    "    random_state=42,\n",
    ")\n",
    "\n",
    "svc = SVC(\n",
    "    C=C,\n",
    "    kernel=\"linear\",\n",
    ")\n",
    "\n",
    "# Relación aproximada entre la regularización de SVM y SGD\n",
    "sgd_clf = SGDClassifier(\n",
    "    loss=\"hinge\",\n",
    "    alpha=1 / (C * len(X_scaled)),\n",
    "    max_iter=100_000,\n",
    "    tol=1e-7,\n",
    "    random_state=42,\n",
    ")\n",
    "\n",
    "models = {\n",
    "    \"LinearSVC\": linear_svc,\n",
    "    \"SVC lineal\": svc,\n",
    "    \"SGDClassifier\": sgd_clf,\n",
    "}\n",
    "\n",
    "for name, model in models.items():\n",
    "    model.fit(X_scaled, y)\n",
    "\n",
    "    print(f\"\\n{name}\")\n",
    "    print(\"Exactitud:\", accuracy_score(y, model.predict(X_scaled)))\n",
    "    print(\"Coeficientes:\", model.coef_)\n",
    "    print(\"Intercepto:\", model.intercept_)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "48baf202",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-28T06:44:35.314346Z",
     "iopub.status.busy": "2026-07-28T06:44:35.313829Z",
     "iopub.status.idle": "2026-07-28T06:44:35.320024Z",
     "shell.execute_reply": "2026-07-28T06:44:35.319093Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "LinearSVC vs. SVC lineal: 100.00%\n",
      "LinearSVC vs. SGDClassifier: 100.00%\n",
      "SVC lineal vs. SGDClassifier: 100.00%\n"
     ]
    }
   ],
   "source": [
    "predictions = {\n",
    "    name: model.predict(X_scaled)\n",
    "    for name, model in models.items()\n",
    "}\n",
    "\n",
    "names = list(models)\n",
    "\n",
    "for i in range(len(names)):\n",
    "    for j in range(i + 1, len(names)):\n",
    "        agreement = np.mean(\n",
    "            predictions[names[i]] == predictions[names[j]]\n",
    "        )\n",
    "        print(f\"{names[i]} vs. {names[j]}: {agreement:.2%}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "d65b8560",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-28T06:44:35.322301Z",
     "iopub.status.busy": "2026-07-28T06:44:35.322054Z",
     "iopub.status.idle": "2026-07-28T06:44:35.415508Z",
     "shell.execute_reply": "2026-07-28T06:44:35.414679Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 900x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.figure(figsize=(9, 6))\n",
    "plt.scatter(\n",
    "    X_scaled[:, 0],\n",
    "    X_scaled[:, 1],\n",
    "    c=y,\n",
    "    cmap=\"bwr\",\n",
    "    edgecolors=\"k\",\n",
    ")\n",
    "\n",
    "x0 = np.linspace(\n",
    "    X_scaled[:, 0].min() - 0.5,\n",
    "    X_scaled[:, 0].max() + 0.5,\n",
    "    200,\n",
    ")\n",
    "\n",
    "styles = [\"-\", \"--\", \":\"]\n",
    "\n",
    "for (name, model), style in zip(models.items(), styles):\n",
    "    w = model.coef_[0]\n",
    "    b = model.intercept_[0]\n",
    "    x1 = -(w[0] * x0 + b) / w[1]\n",
    "    plt.plot(x0, x1, style, linewidth=2, label=name)\n",
    "\n",
    "plt.xlabel(\"Característica 1 estandarizada\")\n",
    "plt.ylabel(\"Característica 2 estandarizada\")\n",
    "plt.legend()\n",
    "plt.grid()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c078b647",
   "metadata": {},
   "source": [
    "10.- Entrena un classificador SVM en ele conjunto de datos wine, que puedes caragar utilizando sklearn.datasets.load_wine(). Este conjunto de datos cintiene los análisis químicos de 178 muestras de vino producidas por 3 agricultores diferentes: el objetivo es entrenar un modelo de clasificacion capaz de predecir el agricultor basándose en el análisis químico del vino. Puesto que los classificadores SVM són binarios, tendrás que que utilizar one-versus-all para clasificar las tres clases. ¿ Qué exactitud puedes lograr ?"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d7c2ee56",
   "metadata": {},
   "source": [
    "### Solución\n",
    "\n",
    "Se reserva un conjunto de prueba estratificado y se aplica el escalado sin\n",
    "filtrar información. Como `SVC` es binario, se envuelve explícitamente en\n",
    "`OneVsRestClassifier` para entrenar un clasificador por cada tipo de vino."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "29b8f5ff",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-28T06:44:35.417138Z",
     "iopub.status.busy": "2026-07-28T06:44:35.416999Z",
     "iopub.status.idle": "2026-07-28T06:44:35.424340Z",
     "shell.execute_reply": "2026-07-28T06:44:35.423609Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Entrenamiento: (133, 13)\n",
      "Prueba: (45, 13)\n",
      "Clases: ['class_0', 'class_1', 'class_2']\n"
     ]
    }
   ],
   "source": [
    "from sklearn.datasets import load_wine\n",
    "from sklearn.model_selection import train_test_split, GridSearchCV\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.multiclass import OneVsRestClassifier\n",
    "from sklearn.svm import SVC\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score,\n",
    "    classification_report,\n",
    "    ConfusionMatrixDisplay,\n",
    ")\n",
    "\n",
    "wine = load_wine()\n",
    "X_wine, y_wine = wine.data, wine.target\n",
    "\n",
    "X_train_wine, X_test_wine, y_train_wine, y_test_wine = train_test_split(\n",
    "    X_wine,\n",
    "    y_wine,\n",
    "    test_size=0.25,\n",
    "    random_state=42,\n",
    "    stratify=y_wine,\n",
    ")\n",
    "\n",
    "print(f\"Entrenamiento: {X_train_wine.shape}\")\n",
    "print(f\"Prueba: {X_test_wine.shape}\")\n",
    "print(f\"Clases: {list(wine.target_names)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "935b21d8",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-28T06:44:35.425899Z",
     "iopub.status.busy": "2026-07-28T06:44:35.425768Z",
     "iopub.status.idle": "2026-07-28T06:44:37.165350Z",
     "shell.execute_reply": "2026-07-28T06:44:37.164468Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Mejores hiperparámetros: {'ovr__estimator__C': 1, 'ovr__estimator__kernel': 'linear'}\n",
      "Exactitud media de validación: 99.26%\n"
     ]
    }
   ],
   "source": [
    "wine_svm = Pipeline([\n",
    "    (\"scaler\", StandardScaler()),\n",
    "    (\"ovr\", OneVsRestClassifier(SVC())),\n",
    "])\n",
    "\n",
    "param_grid = [\n",
    "    {\n",
    "        \"ovr__estimator__kernel\": [\"linear\"],\n",
    "        \"ovr__estimator__C\": [0.01, 0.1, 1, 10, 100],\n",
    "    },\n",
    "    {\n",
    "        \"ovr__estimator__kernel\": [\"rbf\"],\n",
    "        \"ovr__estimator__C\": [0.1, 1, 10, 100],\n",
    "        \"ovr__estimator__gamma\": [\"scale\", 0.01, 0.1, 1],\n",
    "    },\n",
    "]\n",
    "\n",
    "wine_search = GridSearchCV(\n",
    "    wine_svm,\n",
    "    param_grid,\n",
    "    cv=5,\n",
    "    scoring=\"accuracy\",\n",
    "    n_jobs=-1,\n",
    ")\n",
    "wine_search.fit(X_train_wine, y_train_wine)\n",
    "\n",
    "print(\"Mejores hiperparámetros:\", wine_search.best_params_)\n",
    "print(f\"Exactitud media de validación: {wine_search.best_score_:.2%}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "03016a8b",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-28T06:44:37.167321Z",
     "iopub.status.busy": "2026-07-28T06:44:37.167150Z",
     "iopub.status.idle": "2026-07-28T06:44:37.249682Z",
     "shell.execute_reply": "2026-07-28T06:44:37.249048Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Exactitud en prueba: 97.78% (44/45)\n",
      "\n",
      "Informe de clasificación:\n",
      "              precision    recall  f1-score   support\n",
      "\n",
      "     class_0       1.00      1.00      1.00        15\n",
      "     class_1       0.95      1.00      0.97        18\n",
      "     class_2       1.00      0.92      0.96        12\n",
      "\n",
      "    accuracy                           0.98        45\n",
      "   macro avg       0.98      0.97      0.98        45\n",
      "weighted avg       0.98      0.98      0.98        45\n",
      "\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "y_pred_wine = wine_search.predict(X_test_wine)\n",
    "wine_accuracy = accuracy_score(y_test_wine, y_pred_wine)\n",
    "\n",
    "print(\n",
    "    f\"Exactitud en prueba: {wine_accuracy:.2%} \"\n",
    "    f\"({(y_pred_wine == y_test_wine).sum()}/{len(y_test_wine)})\"\n",
    ")\n",
    "print(\"\\nInforme de clasificación:\")\n",
    "print(\n",
    "    classification_report(\n",
    "        y_test_wine,\n",
    "        y_pred_wine,\n",
    "        target_names=wine.target_names,\n",
    "    )\n",
    ")\n",
    "\n",
    "ConfusionMatrixDisplay.from_predictions(\n",
    "    y_test_wine,\n",
    "    y_pred_wine,\n",
    "    display_labels=wine.target_names,\n",
    "    cmap=\"Blues\",\n",
    ")\n",
    "plt.title(\"SVM one-versus-rest: conjunto Wine\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b01e1b83",
   "metadata": {},
   "source": [
    "**Conclusión:** el mejor modelo consigue aproximadamente un\n",
    "**97,8 % de exactitud** en el conjunto de prueba (44 predicciones correctas\n",
    "de 45). La matriz de confusión permite ver que solo se confunde una muestra."
   ]
  },
  {
